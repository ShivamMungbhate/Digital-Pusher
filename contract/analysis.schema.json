{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AnalysisResponse",
  "type": "object",
  "required": [
    "mode",
    "risk",
    "verdict",
    "confidence",
    "summary",
    "tactics",
    "findings",
    "clauses",
    "deadlines",
    "safeSteps",
    "drafts",
    "escalate",
    "disclaimer"
  ],
  "properties": {
    "mode": {
      "type": "string",
      "enum": ["scam", "dark_pattern", "paperwork"]
    },
    "risk": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "verdict": {
      "type": "string",
      "enum": ["likely_scam", "unclear", "looks_genuine", "issues_found", "no_issues"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "summary": {
      "type": "string"
    },
    "tactics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "evidence", "severity"],
        "properties": {
          "name": {
            "type": "string",
            "enum": ["urgency", "authority", "fear", "secrecy", "payment_demand", "other"]
          },
          "evidence": { "type": "string" },
          "severity": { "type": "string", "enum": ["low", "medium", "high"] }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "category", "explanation", "severity"],
        "properties": {
          "type": { "type": "string" },
          "category": { "type": "string" },
          "timestampSec": { "type": ["number", "null"] },
          "explanation": { "type": "string" },
          "severity": { "type": "string", "enum": ["low", "medium", "high"] }
        }
      }
    },
    "clauses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text", "risk", "reason"],
        "properties": {
          "text": { "type": "string" },
          "risk": { "type": "string", "enum": ["low", "medium", "high"] },
          "reason": { "type": "string" },
          "citation": { "type": ["string", "null"] }
        }
      }
    },
    "deadlines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "date", "source"],
        "properties": {
          "label": { "type": "string" },
          "date": { "type": "string" },
          "source": { "type": "string" }
        }
      }
    },
    "safeSteps": {
      "type": "array",
      "items": { "type": "string" }
    },
    "drafts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "title", "body"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["family_alert", "report", "complaint", "reply", "cancellation"]
          },
          "title": { "type": "string" },
          "body": { "type": "string" }
        }
      }
    },
    "audioUrl": {
      "type": ["string", "null"]
    },
    "escalate": {
      "type": "boolean"
    },
    "disclaimer": {
      "type": "string"
    }
  }
}
