# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Database
MONGO_URI=mongodb://localhost:27017/digital_pusher

# Redis (optional: if omitted, in-process queue fallback is used automatically)
REDIS_URL=redis://localhost:6379

# JWT Auth
JWT_SECRET=super_secret_jwt_key_for_hackathon_demo_32chars!
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=refresh_secret_jwt_key_hackathon_32chars!
REFRESH_TOKEN_EXPIRES_IN=7d

# Storage & AES-256-GCM Encryption Key (64 hex characters = 32 bytes)
STORAGE_TYPE=local
STORAGE_PATH=./uploads
STORAGE_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
MEDIA_RETENTION_DAYS=7

# AI Service (pointing to mock by default; switch to Gemini team service URL without code change)
AI_SERVICE_URL=http://localhost:5001

# Notifications (Email via Nodemailer)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Digital Pusher <no-reply@digitalpusher.org>"

# Telegram Bot (optional for local dev, required for Telegram demo)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=DigitalPusherBot

# Optional Twilio SMS (behind feature flag)
ENABLE_TWILIO=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Client (apps/web)
VITE_API_BASE_URL=http://localhost:4000/api
