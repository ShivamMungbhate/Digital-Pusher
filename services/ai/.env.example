# Server Configuration
PORT=5001
HOST=0.0.0.0
ENVIRONMENT=development

# Gemini API Configuration (Official google-genai SDK)
GEMINI_API_KEY=your_gemini_api_key_here

# Model Configuration (Read dynamically from env, never hardcoded)
# Fast model: routing, initial intake, rapid structured analysis
GEMINI_FAST_MODEL=gemini-2.0-flash

# Strong model: complex reasoning, drafting replies/complaints, hard edge-cases
GEMINI_STRONG_MODEL=gemini-2.5-flash

# Embeddings model: RAG knowledge retrieval
GEMINI_EMBED_MODEL=text-embedding-004

# Audio/TTS Model: voice synthesis for senior explanations
GEMINI_TTS_MODEL=gemini-2.0-flash

# Knowledge Base & Audio Cache
KNOWLEDGE_DIR=./knowledge
AUDIO_CACHE_DIR=./audio_cache
